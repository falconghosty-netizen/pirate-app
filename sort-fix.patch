+// Pull the real, server-side sorted flag so it's the same for every
+// staff member and survives page refreshes.
+async function loadSortStatus() {
+  const res = await fetch("/api/staff/sort-status");
+  if (!res.ok) return;
+  const data = await res.json();
+  sortedView = !!data.sorted;
+  applySortedUi();
+}
+
+function applySortedUi() {
+  const btn = document.getElementById("sortBtn");
+  const banner = document.getElementById("sortedBanner");
+  if (sortedView) {
+    btn.textContent = "🔒 Sorted — Decision Mode Active";
+    btn.classList.add("locked");
+    btn.disabled = true;
+    banner.classList.add("visible");
+  } else {
+    btn.textContent = "⬇ Sort by Rating (High → Low)";
+    btn.classList.remove("locked");
+    btn.disabled = false;
+    banner.classList.remove("visible");
+  }
+}
